{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mob_battle:compressed_copper_lightning",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "mob_battle:lightning"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 50
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.sin(v.particle_random_1 * 360)", 0, "math.cos(v.particle_random_1 * 360)"]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.size = 0.2 + (v.particle_age / v.particle_lifetime) * (v.particle_random_2 + 1) / 2;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.2, 1)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": 7,
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 2
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size", "v.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 10,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.5": "#FF5FF8FF",
						"1.0": "#002F00FF"
					}
				}
			}
		}
	}
}
