{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mob_battle:wither_dark_spark",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "mob_battle:wither_dark_spark"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 400,
				"max_particles": 400
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": ["math.sin(v.particle_random_2 * 360) * v.radius", 0, "math.cos(v.particle_random_2 * 360) * v.radius"],
				"direction": [0, -1, 0]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.radius = v.particle_random_1 * 3;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "((2 - v.radius) * 0.1 + 0.2) * 2"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)",
				"rotation_rate": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": "math.random(10, 30) * (3 - v.radius) * 0.5",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.random(-30, 30)", 0, "math.random(-30, 30)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.2 + 0.5 * v.particle_random_4", "0.2 + 0.5 * v.particle_random_4"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFF0000",
						"0.5": "#B8000000",
						"0.92": "#00000000"
					}
				}
			}
		}
	}
}
