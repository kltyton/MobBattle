{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mob_battle:wither_flash_burst",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "mob_battle:wither_flash_burst"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 15
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.random(-0.2,0.2)", -1, "math.random(-0.2,0.2)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.5
			},
			"minecraft:particle_initial_speed": "math.random(2,5) * 3",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -50, 0],
				"linear_drag_coefficient": 0.1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.02 + 0.18 * (1-v.particle_age/v.particle_lifetime)", 0.02],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"coefficient_of_restitution": 0.3,
				"collision_radius": 0.2
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFF0000",
						"0.77": "#FF50004E",
						"1.0": "#ff000000"
					}
				}
			}
		}
	}
}
