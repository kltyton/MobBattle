{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mob_battle:particle4",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "mob_battle:attack"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 12
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.random(-1,1)", 0, -2]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.size = 1 + 7 * (v.particle_age / v.particle_lifetime) * math.random(0.9,1.1);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.8
			},
			"minecraft:particle_initial_speed": 60,
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size", "v.size"],
				"facing_camera_mode": "direction_x",
				"uv": {
					"texture_width": 32,
					"texture_height": 32,
					"uv": [0, 0],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.24": "#6EFFE800",
						"0.5": "#00FFD400"
					}
				}
			}
		}
	}
}