{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mob_battle:vindicator_impact_bomb",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "mob_battle:vindicator_impact_bomb"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 23
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": ["math.random(-1,1)", "math.random(0.1,0.5)", "math.random(-1,1)"]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.size = (1 - 2 * math.abs(v.particle_age / v.particle_lifetime - 0.5));"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.2, 0.5)"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["4 * math.random(0.8, 1) * v.size", "4 * math.random(0.8, 1) * v.size"],
				"facing_camera_mode": "direction_y",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.42": "#FFFFC600",
						"0.72": "#80FF6700",
						"1.0": "#00FF0000"
					}
				}
			}
		}
	}
}
