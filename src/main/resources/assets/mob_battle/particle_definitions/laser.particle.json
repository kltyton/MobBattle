{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mob_battle:laser",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "mob_battle:laser"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 16
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.35
			},
			"minecraft:emitter_shape_point": {
				"direction": [
					"math.random(-0.45, 0.45)",
					"math.random(-0.45, 0.45)",
					-1
				]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.scale = math.random(0.7, 1.3);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.22, 0.38)"
			},
			"minecraft:particle_initial_speed": "math.random(18, 32)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 2
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.12 * v.scale",
					"1.6 * v.scale * (1 - v.particle_age / v.particle_lifetime)"
				],
				"facing_camera_mode": "direction_y",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.18": "#00EFFFFF",
						"1.0": "#00AFFF00"
					}
				}
			}
		}
	}
}
