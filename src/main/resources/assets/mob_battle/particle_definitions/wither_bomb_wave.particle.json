{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mob_battle:wither_bomb_wave",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "mob_battle:wither_bomb_wave"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 10
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0, "math.random(0, 3)"],
				"direction": ["math.random(-0.2,0.2)", "math.random(-0.2,0.2)", 1]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.scale = (0.25 + 0.5 * v.particle_random_1);v.size = (1 - math.pow((v.particle_age / v.particle_lifetime) * 2 - 1, 4)) * v.scale;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.3, 0.7) * 0.5"
			},
			"minecraft:particle_initial_speed": 0.01,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size * math.random(0.9, 1)", "v.size * math.random(0.9, 1)"],
				"facing_camera_mode": "direction_z",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.29": "#FFFF0000",
						"0.63": "#80FF0087",
						"1.0": "#FF000000"
					}
				}
			}
		}
	}
}
