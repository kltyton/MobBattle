{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mob_battle:wither_shadow_texture",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "mob_battle:wither_shadow_texture"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 4
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.size = (1 - math.pow((v.particle_age / v.particle_lifetime) * 2 - 1, 6));"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.5
			},
			"minecraft:particle_initial_speed": 0.01,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["(3 + 3 * v.particle_random_1) * v.size", "(3 + 3 * v.particle_random_1) * v.size"],
				"facing_camera_mode": "direction_z",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFF0000",
						"0.77": "#FF50004E",
						"1.0": "#ff000000"
					}
				}
			}
		}
	}
}
