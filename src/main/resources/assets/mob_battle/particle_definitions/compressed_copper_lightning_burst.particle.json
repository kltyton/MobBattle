{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mob_battle:compressed_copper_lightning_burst",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "mob_battle:bomb_round"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 10
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.size = v.particle_age / v.particle_lifetime * (2 + v.particle_random_1) * math.random(0.9, 1);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.4, 0.6)"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size", "v.size"],
				"facing_camera_mode": "direction_y",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.5": "#FF3AFFEF",
						"1.0": "#00002AFF"
					}
				}
			}
		}
	}
}
