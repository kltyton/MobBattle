{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mob_battle:vindicator_flash_burst",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "mob_battle:vindicator_flash_burst"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": ["math.random(-0.5,0.5)", 0.2, "math.random(-0.5,0.5)"],
				"direction": ["math.random(-0.5,0.5)", 1, 1]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.height = math.random(2,20);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.height * 0.06 + 0.01"
			},
			"minecraft:particle_initial_speed": "v.height * 1.5",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -50, 0],
				"linear_drag_coefficient": 0.1
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.6, 0.05],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"coefficient_of_restitution": 0.3,
				"collision_radius": 0.2
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.3": "#FFFFDD00",
						"0.67": "#87FF5300",
						"1.0": "#00FF0000"
					}
				}
			}
		}
	}
}
