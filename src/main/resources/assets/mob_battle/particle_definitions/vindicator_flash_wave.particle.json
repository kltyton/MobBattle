{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mob_battle:vindicator_flash_wave",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "mob_battle:vindicator_flash_wave"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": ["math.sin(v.particle_random_2 * 360) * v.radius", "math.cos(v.particle_random_2 * 360) * v.radius", 0],
				"direction": [0, 0, 1]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.radius = v.particle_random_1 * 2;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "((2 - v.radius) * 0.1 + 0.2) * 2"
			},
			"minecraft:particle_initial_speed": "math.random(10, 30) * (2 - v.radius) * 3",
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [1, 0.06],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.25": "#FFFFD500",
						"0.56": "#87FF4700",
						"0.83": "#00FF0000"
					}
				}
			}
		}
	}
}
